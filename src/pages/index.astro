---
import Layout from '../layouts/BlogPost.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const restaurantName = "The Golden Bistro";

const menuItems = [
  { category: "Starters", name: "Truffle Fries", price: "$9", desc: "Crispy hand-cut potatoes, parmesan, truffle oil, fresh rosemary." },
  { category: "Starters", name: "Crispy Calamari", price: "$14", desc: "Tender calamari rings served with house-made lemon aioli." },
  { category: "Mains", name: "Pan-Seared Salmon", price: "$26", desc: "Wild-caught salmon, asparagus, garlic mashed potatoes, lemon-dill cream." },
  { category: "Mains", name: "Classic Wagyu Burger", price: "$19", desc: "Aged white cheddar, caramelized onions, brioche bun, house sauce." },
  { category: "Desserts", name: "Lava Cake", price: "$8", desc: "Warm chocolate cake with a molten center, served with vanilla bean ice cream." }
];
---

<Layout title={restaurantName}>
	<Header />
	<main>
		<!-- Hero Section -->
		<section class="hero">
			<div class="hero-content">
				<h1>Welcome to {restaurantName}</h1>
				<p>Crafting unforgettable culinary experiences daily.</p>
				<a href="#menu" class="btn">View Our Menu</a>
			</div>
		</section>

		<div class="container">
			<!-- Info Grid -->
			<section class="info-grid">
				<div class="info-card">
					<h3>🕒 Hours</h3>
					<p>Mon - Thu: 12PM - 9PM<br>Fri - Sun: 11AM - 10PM</p>
				</div>
				<div class="info-card">
					<h3>📍 Location</h3>
					<p>123 Gourmet Street<br>Food District, NY 10001</p>
				</div>
				<div class="info-card">
					<h3>📞 Reservations</h3>
					<p>Call: (555) 019-2834<br>Or walk right in!</p>
				</div>
			</section>

			<!-- Interactive Menu -->
			<section id="menu" class="menu-section">
				<h2>Our Culinary Menu</h2>
				<div class="menu-grid">
					{menuItems.map(item => (
						<div class="menu-item">
							<div class="menu-header">
								<span class="item-name">{item.name}</span>
								<span class="item-price">{item.price}</span>
							</div>
							<p class="item-desc">{item.desc}</p>
							<span class="item-tag">{item.category}</span>
						</div>
					))}
				</div>
			</section>
		</div>
	</main>
	<Footer />
</Layout>

<style>
	body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 0; background-color: #faf8f5; color: #2b2d42; }
	.container { max-width: 1000px; margin: 0 auto; padding: 0 20px; }
	
	.hero { 
		background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.6)), url('https://unsplash.com') no-repeat center center/cover;
		height: 50vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		color: white;
	}
	.hero h1 { font-size: 3rem; margin: 0; letter-spacing: 1px; }
	.hero p { font-size: 1.2rem; margin: 15px 0 25px 0; font-style: italic; }
	.btn { background-color: #d90429; color: white; padding: 12px 30px; text-decoration: none; font-weight: bold; border-radius: 5px; transition: 0.3s; }
	.btn:hover { background-color: #ef233c; }

	.info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin: -40px auto 60px auto; position: relative; z-index: 10; }
	.info-card { background: white; padding: 25px; border-radius: 8px; text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border-top: 4px solid #d90429; }
	.info-card h3 { margin-top: 0; color: #2b2d42; }

	.menu-section { margin-bottom: 80px; }
	.menu-section h2 { text-align: center; font-size: 2.2rem; margin-bottom: 40px; color: #2b2d42; }
	.menu-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; }
	.menu-item { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.02); display: flex; flex-direction: column; justify-content: space-between; position: relative; }
	.menu-header { display: flex; justify-content: space-between; font-weight: bold; font-size: 1.1rem; border-bottom: 1px dashed #ccc; padding-bottom: 5px; }
	.item-price { color: #d90429; }
	.item-desc { font-size: 0.9rem; color: #6c757d; margin: 10px 0; }
	.item-tag { font-size: 0.75rem; text-transform: uppercase; background: #f1faee; color: #457b9d; padding: 3px 8px; border-radius: 4px; align-self: flex-start; font-weight: bold; }
</style>
