---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">The Golden Bistro</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="#menu">Menu</HeaderLink>
			<HeaderLink href="/blog">Our Culinary Blog</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header { margin: 0; padding: 0 1em; background: white; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
	h2 { margin: 0; font-size: 1.25rem; }
	h2 a, h2 a.active { text-decoration: none; color: #2b2d42; font-weight: 900; }
	nav { display: flex; align-items: center; justify-content: space-between; max-width: 1000px; margin: 0 auto; padding: 1em 0; }
	.internal-links a { padding: 1em 0.5em; color: #6c757d; text-decoration: none; font-weight: 500; }
	.internal-links a:hover { color: #d90429; }
</style>
